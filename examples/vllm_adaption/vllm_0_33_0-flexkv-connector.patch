+class TestFlexKVConnectorConfig:
+    def test_kv_cache_config_is_forwarded(self):
+        from vllm.distributed.kv_transfer.kv_connector.v1.flexkv_connector import (
+            FlexKVConnectorV1,
+        )
+
+        vllm_config = _make_vllm_config()
+        kv_cache_config = _make_kv_cache_config()
+        with _install_flexkv_mock(MagicMock()):
+            FlexKVConnectorV1(vllm_config, KVConnectorRole.SCHEDULER, kv_cache_config)
+            impl_cls = sys.modules[
+                "flexkv.integration.vllm.vllm_v1_adapter"
+            ].FlexKVConnectorV1Impl
+        impl_cls.assert_called_once_with(
+            vllm_config, KVConnectorRole.SCHEDULER, kv_cache_config
+        )
+
+    def test_requires_token_major_layout(self):
+        from vllm.distributed.kv_transfer.kv_connector.v1.flexkv_connector import (
+            FlexKVConnectorV1,
+        )
+
+        assert FlexKVConnectorV1.get_required_kvcache_layout(MagicMock()) == "LBNHC"
+
+    def test_piecewise_cudagraph_required_only_for_layerwise(self):
+        from vllm.distributed.kv_transfer.kv_connector.v1.flexkv_connector import (
+            FlexKVConnectorV1,
+        )
+
+        assert FlexKVConnectorV1.requires_piecewise_for_cudagraph(
+            {"use_layerwise": True}
+        )
+        assert not FlexKVConnectorV1.requires_piecewise_for_cudagraph({})
+
+    def test_saves_are_best_effort(self):
+        connector = _build_connector(_make_vllm_config(), MagicMock())
+        assert not connector.requires_kv_delivery
+
